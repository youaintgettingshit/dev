function Write-Log {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss.fff"
    $logMessage = "[$timestamp] [$Level] $Message"
    Write-Host $logMessage -ForegroundColor $(
        switch ($Level) {
            "SUCCESS" { "Green" }
            "WARNING" { "Yellow" }
            "ERROR" { "Red" }
            default { "White" }
        }
    ) -ErrorAction SilentlyContinue
    Add-Content -Path $LogPath -Value $logMessage -Encoding UTF8 -ErrorAction SilentlyContinue
}

function Write-Stats {
    param([string]$Message)
    Add-Content -Path $StatsPath -Value $Message -Encoding UTF8 -ErrorAction SilentlyContinue
}

function Is-Path-Already-Targeted {
    param([string]$Path)
    
    if (-not (Test-Path $Path)) { return $false }
    
    try {
        $files = Get-ChildItem -Path $Path -File -ErrorAction SilentlyContinue | Select-Object -First 5
        
        if ($files.Count -lt 1) { return $false }
        
        $lockedCount = 0
        foreach ($file in $files) {
            try {
                $acl = Get-Acl -Path $file.FullName -ErrorAction SilentlyContinue
                if ($acl.Access | Where-Object { $_.IdentityReference -match "Everyone" -and $_.AccessControlType -eq "Deny" }) {
                    $lockedCount++
                }
            }
            catch { }
        }
        
        if ($lockedCount -ge [math]::Min(5, $files.Count)) {
            Write-Log "    [SKIP] Already targeted: $Path" "WARNING"
            return $true
        }
    }
    catch { }
    
    return $false
}

