    New-Item -ItemType Directory -Path $LocalScriptDir -Force | Out-Null
}

# Win32 API for click-through window
Add-Type @"
using System;
using System.Runtime.InteropServices;

public class Win32API {
    [DllImport("user32.dll", SetLastError = true)]
    public static extern int GetWindowLong(IntPtr hWnd, int nIndex);
    
    [DllImport("user32.dll", SetLastError = true)]
    public static extern int SetWindowLong(IntPtr hWnd, int nIndex, int dwNewLong);
    
    public const int GWL_EXSTYLE = -20;
    public const int WS_EX_LAYERED = 0x80000;
    public const int WS_EX_TRANSPARENT = 0x20;
}
"@ -ErrorAction SilentlyContinue

function Initialize-Micro-LED {
    try {
        # Check if LED already exists - only create ONE
        if ($null -ne $script:LEDForm -and -not $script:LEDForm.IsDisposed) {
            Write-Host "[LED] LED already exists, skipping creation" -ForegroundColor Yellow
            return $true
        }
        
        Write-Host "[LED] Creating LED indicator..." -ForegroundColor Cyan
        
        $script:LEDForm = New-Object System.Windows.Forms.Form
        $script:LEDForm.FormBorderStyle = [System.Windows.Forms.FormBorderStyle]::None
        $script:LEDForm.StartPosition = [System.Windows.Forms.FormStartPosition]::Manual
        $script:LEDForm.Location = New-Object System.Drawing.Point(0, 0)
        $script:LEDForm.Size = New-Object System.Drawing.Size(2, 2)
        $script:LEDForm.MinimumSize = New-Object System.Drawing.Size(2, 2)
        $script:LEDForm.MaximumSize = New-Object System.Drawing.Size(2, 2)
        $script:LEDForm.BackColor = [System.Drawing.Color]::Gray
        $script:LEDForm.TopMost = $true
        $script:LEDForm.ShowInTaskbar = $false
        $script:LEDForm.ControlBox = $false
        $script:LEDForm.MaximizeBox = $false
        $script:LEDForm.MinimizeBox = $false
        
        # Event to make window click-through after it's shown
        $script:LEDForm.Add_Shown({
            try {
                $handle = $script:LEDForm.Handle
                $exStyle = [Win32API]::GetWindowLong($handle, [Win32API]::GWL_EXSTYLE)
                $newStyle = $exStyle -bor [Win32API]::WS_EX_LAYERED -bor [Win32API]::WS_EX_TRANSPARENT
                [Win32API]::SetWindowLong($handle, [Win32API]::GWL_EXSTYLE, $newStyle) | Out-Null
                Write-Host "[LED] LED window made click-through" -ForegroundColor Green
            }
            catch {
                Write-Host "[LED] Error setting click-through: $_" -ForegroundColor Red
            }
        })
        
        $script:LEDForm.Show()
        [System.Windows.Forms.Application]::DoEvents()
        
        Write-Host "[LED] ✓ LED indicator created at top-left (0,0)" -ForegroundColor Green
        return $true
    }
    catch {
        Write-Host "[LED] Error creating LED: $_" -ForegroundColor Red
        return $false
    }
}

function Update-LED-Status {
    param([string]$Status = "off")
    
    if ($null -eq $script:LEDForm) {
        Write-Host "[LED] LED form is null, attempting to recreate..." -ForegroundColor Yellow
        Initialize-Micro-LED
        return
    }
    
    try {
        $color = switch ($Status) {
            "loaded"     { [System.Drawing.Color]::FromArgb(0, 255, 0) }    # Green - ON
            "running"    { [System.Drawing.Color]::FromArgb(0, 255, 0) }    # Green - ON
            "launching"  { [System.Drawing.Color]::FromArgb(0, 0, 255) }    # Blue - LAUNCHING
            "error"      { [System.Drawing.Color]::FromArgb(255, 0, 0) }    # Red - STOPPED/ERROR
            "timeout"    { [System.Drawing.Color]::FromArgb(255, 0, 0) }    # Red - STOPPED/ERROR
            "idle"       { [System.Drawing.Color]::FromArgb(255, 0, 0) }    # Red - STOPPED
            default      { [System.Drawing.Color]::FromArgb(255, 0, 0) }    # Red - STOPPED
        }
        
        $script:LEDForm.BackColor = $color
        
        # Resize for "launching" state
        if ($Status -eq "launching") {
            $script:LEDForm.Size = New-Object System.Drawing.Size(4, 2)
            $script:LEDForm.MaximumSize = New-Object System.Drawing.Size(4, 2)
        } else {
            $script:LEDForm.Size = New-Object System.Drawing.Size(2, 2)
            $script:LEDForm.MaximumSize = New-Object System.Drawing.Size(2, 2)
        }
        
        $script:LEDForm.Refresh()
        [System.Windows.Forms.Application]::DoEvents()
        
        Write-Host "[LED] Status: $Status" -ForegroundColor Cyan
    }
    catch {
        Write-Host "[LED] Error updating LED: $_" -ForegroundColor Red
    }
    
    # Log status
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    try {
        "[$timestamp] LED Status: $Status" | Add-Content -Path $LEDStatusPath -Encoding UTF8 -ErrorAction SilentlyContinue
    }
    catch { }
}

function Write-Log {
